# Copy to .env (./uf.sh setup does it for you) and adjust.

# Customers get <slug>.BASE_DOMAIN unless you pass --domain.
# Point a wildcard DNS record (*.BASE_DOMAIN) to this server.
BASE_DOMAIN=example.ir
# Contact for Let's Encrypt certificates.
ACME_EMAIL=admin@example.ir

# Image built by ./uf.sh build (or pulled from your registry).
IMAGE=unifinance:latest

# Base images. On servers that cannot reach Docker Hub use a mirror, e.g.
#   mirror.gcr.io/library/mariadb:11  (or set "registry-mirrors" in /etc/docker/daemon.json)
MARIADB_IMAGE=mariadb:11
CADDY_IMAGE=caddy:2-alpine
NODE_IMAGE=node:22-alpine
GO_IMAGE=golang:1.24-alpine
RUNTIME_IMAGE=alpine:3.20
NPM_REGISTRY=https://registry.npmjs.org/
GOPROXY=https://proxy.golang.org,direct

# Generated by setup — keep it secret.
MARIADB_ROOT_PASSWORD=

# Nightly backups are kept this many days.
BACKUP_KEEP_DAYS=14

# Optional SMS for all tenants that do not set their own (Melipayamak).
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_FROM=
