# Created by ./install.sh — edit and run: docker compose up -d

# Public domain (HTTPS is automatic) — or leave empty for a LAN install over http://SERVER-IP
DOMAIN=
# Caddy site address and the URL users open (install.sh fills these from DOMAIN)
SITE_ADDRESS=
SITE_URL=
ACME_EMAIL=

ORG_NAME=
ADMIN_EMAIL=
# Only used on the very first start (then change it from the profile page)
ADMIN_PASSWORD=

DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=

# Optional: online payment gateway and SMS panel of your organization
ZARINPAL_MERCHANT_ID=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_FROM=

IMAGE=unifinance:latest
# If Docker Hub is not reachable, use a mirror, e.g. mirror.gcr.io/library/mariadb:11
# (or set "registry-mirrors" in /etc/docker/daemon.json)
MARIADB_IMAGE=mariadb:11
CADDY_IMAGE=caddy:2-alpine
HTTP_PORT=80
HTTPS_PORT=443
